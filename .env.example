# Convecta Prop360 — configure the real value as a Replit Secret.
CONVECTA_SUBSCRIPTION_KEY=

# Optional backend configuration.
CONVECTA_API_URL=https://api-cnvct.azure-api.net/web/v1/properties
CONVECTA_SYNC_INTERVAL_MINUTES=5
CONVECTA_MAX_SYNC_PAGES=20

# Local frontend-to-backend routing.
API_PROXY_TARGET=http://127.0.0.1:8080

# Keep false in production. Set true only for a visual review without Convecta.
VITE_DEMO_PROPERTIES=false